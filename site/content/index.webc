---js
const title = "Home"
---

<h1>Home</h1>

<p>logo carousel nuevo 1</p>

<div id="logoCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="2000">
            <div class="carousel-inner">
                <!-- First Slide: First 4 logos -->
                <div class="carousel-item active">
                    <div class="row justify-content-center align-items-center">
                        <div class="col-auto">
                            <img src="https://via.placeholder.com/100x50?text=Supabase" alt="Supabase" class="img-fluid" style="height: 50px;">
                        </div>
                        <div class="col-auto">
                            <img src="https://via.placeholder.com/100x50?text=SQLite" alt="SQLite" class="img-fluid" style="height: 50px;">
                        </div>
                        <div class="col-auto">
                            <img src="https://via.placeholder.com/100x50?text=Logo3" alt="Logo3" class="img-fluid" style="height: 50px;">
                        </div>
                        <div class="col-auto">
                            <img src="https://via.placeholder.com/100x50?text=Logo4" alt="Logo4" class="img-fluid" style="height: 50px;">
                        </div>
                    </div>
                </div>
                <!-- Second Slide: Last 3 logos -->
                <div class="carousel-item">
                    <div class="row justify-content-center align-items-center">
                        <div class="col-auto">
                            <img src="https://via.placeholder.com/100x50?text=Kotlin" alt="Kotlin" class="img-fluid" style="height: 50px;">
                        </div>
                        <div class="col-auto">
                            <img src="https://via.placeholder.com/100x50?text=Java" alt="Java" class="img-fluid" style="height: 50px;">
                        </div>
                        <div class="col-auto">
                            <img src="https://via.placeholder.com/100x50?text=Supak" alt="Supak" class="img-fluid" style="height: 50px;">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Optional: Carousel Controls -->
            <button class="carousel-control-prev" type="button" data-bs-target="#logoCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#logoCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>