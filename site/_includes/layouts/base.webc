---js
const items = [{ path: "/", name: "Home" }, { path: "/desktop", name: "Desktop" }, { path: "/mobile", name: "Mobile" }, { path: "/web", name: "Web" }]
---
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title @text="title"></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/assets/css/styles.css">
</head>

<body>
    <nav webc:is="components/navbar"></nav>

    <main class="container mt-3">
        <slot></slot> <!-- Aquí se insertará el contenido de cada página -->
    </main>

    <footer webc:is="components/footer"></footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/assets/js/scripts.js"></script>
</body>

</html>
